# =============================================================
# Prism — 环境变量示例
# 复制为 .env，填写真实值，不要提交 .env 到 git
# =============================================================

# --- 基础 ---
APP_ENV=dev                        # dev | staging | prod
LOG_LEVEL=INFO

# --- 日志文件 ---
LOG_FILE_ENABLED=true              # false = 只输出到 stdout（容器/无盘环境）
LOG_DIR=logs                       # 日志目录，相对于工作目录
LOG_MAX_BYTES=20971520             # 单文件最大字节数（默认 20 MB）
LOG_BACKUP_COUNT=10                # 保留最近 N 个滚动文件
TZ=Asia/Shanghai
SERVICE_NAME=prism

# --- 传输 ---
MCP_TRANSPORT=http                 # stdio | http
HOST=0.0.0.0
PORT=8000
SSE_HEARTBEAT_SEC=25

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_MAX_CONN=200
REDIS_CLUSTER_MODE=true
REDIS_KEY_PREFIX=prism:

# --- 引擎 ---
# 一源一实例分片（推荐）：每引擎一个 SearXNG 实例，独立熔断/超时，慢源卡死只损失该源。
# 格式 "引擎名=实例URL" 逗号分隔（引擎名可含空格，如 sogou wechat）；与 compose 的
# searxng-* 服务名一一对应。留空则回退 SEARXNG_URLS 全引擎多实例模式（page N 路由实例 N）。
SEARXNG_SHARDS=baidu=http://searxng-baidu:8080,bing=http://searxng-bing:8080,quark=http://searxng-quark:8080,sogou=http://searxng-sogou:8080,sogou wechat=http://searxng-wechat:8080
# 发给 SearXNG 的 X-Forwarded-For/X-Real-IP，必须是非 loopback 地址（否则 botdetection 403）
SEARXNG_FORWARDED_FOR=10.0.0.1
# S 档默认不含 google（国内不可达）；M/L 档开代理后可加
# 360search 已移除：对机房/代理 IP 反爬激进，常返回空 body（lxml ParserError: Document is empty）
# sogou wechat：公众号文章，时效/正文优于通用网页；bilibili 已移除（视频对网页查询是噪音）
# baidu：引擎为 HTML 解析 override 版（searxng/overrides/baidu.py 挂载进 searxng-baidu，
# 上游 tn=json 接口必触发验证码已弃用）；baidu/quark 出网由 proxy-hub 按目标站自动
# 路由到独享池（PROXY_HUB_EXCLUSIVE_* 在 proxy-hub 侧配置，本服务零配置）
# quark：引擎为挂起时长 override 版（searxng/overrides/quark.py 挂载进 searxng-quark，
# 上游 quark.py:89 硬编码 suspended_time=900 覆盖 settings 的 10s，一次 CAPTCHA 挂起 15 分钟）
# 唯一来源是本文件（引擎清单经请求参数 engines= 下发，settings.template.yml 只登记不决定；
# 分片模式下 SEARXNG_ENGINES 仅为文档性全集，实际切片由 SEARXNG_SHARDS 决定）
SEARXNG_ENGINES=baidu,bing,sogou,quark,sogou wechat

# ChinaSo（中国搜索，权威源）：JSON 接口已逆向，按 IP 风控需经代理池出网（uid cookie 预热）。
# 默认关；代理池有活 IP 时验证能拿到真实结果（非 "ip control"）后再设 true。
CHINASO_ENABLED=false

# 框架词软剥离：发引擎前剥掉"适合/推荐/的/怎么样"等低信息量框架词，避免多约束长尾
# 查询（"适合油性敏感肌的平价洗面奶推荐"）坍缩成单高频词招来字典/百科页。
# 常开；原串始终保留给排序，关掉只收窄召回宽度，出问题可一键回滚。
ENABLE_FRAMING_STRIP=true

DDGS_ENABLED=false

SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
BRAVE_API_KEY=
TAVILY_API_KEY=
VOLCENGINE_API_KEY=

# --- Elasticsearch ---
# 两个用途共用同一个 ES 实例，但索引完全隔离：
#   ES_INDEX=hot_news     ← crawler 写入的热点内容索引（热路命中）
#   LOG_ES_INDEX=prism_logs ← Prism 自身运行日志索引（与热点内容无关）
ES_URL=http://localhost:9200
# ES 认证（可选，无密码留空）
ES_USER=elastic
ES_PASSWORD=

# 热点索引（crawler 项目写入，gateway 读取；crawler 就绪后再开启）
ES_INDEX=hot_news                      # 与 crawler/.env 中 ES_INDEX 保持一致
HOT_INDEX_ENABLED=true               # true = 优先查热点索引，命中跳过 SearXNG
HOT_INDEX_MIN_HITS=3                  # 命中数低于此值时降级至 SearXNG

# 日志写入 ES（独立索引，不影响热点查询）
LOG_ES_ENABLED=true                  # true = 异步将运行日志写入 ES
LOG_ES_INDEX=prism_logs               # 日志专用索引，与 ES_INDEX(hot_news) 完全隔离
LOG_ES_MIN_LEVEL=INFO                 # 写入 ES 的最低级别（DEBUG/INFO/WARNING/ERROR）
LOG_ES_BATCH_SIZE=100                 # 每批写入条数
LOG_ES_FLUSH_INTERVAL_S=5.0          # 最长多久刷一次（秒）

# --- 代理出网（代理池由独立 proxy-hub 服务托管，gateway 不维护代理池） ---
# proxy-hub 服务地址（控制面，逗号分隔多副本主备自动故障转移，如 http://<proxy-hub-1>:8100,http://<proxy-hub-2>:8100）：
# **proxy-hub 拓扑唯一事实源**。三处消费，全部由本行驱动：
#   1. gateway 控制面：节流上报活跃信号（驱动按需补位与 QPS 升档）、引擎熔断/风控时请求立即抽新 IP；
#   2. gateway 数据面（fetcher/ChinaSo）：隧道地址由本行推导——host 相同、端口固定换 8101
#      （proxy-hub 隧道端口契约），账密用下一行 token 注入；
#   3. searxng settings：容器启动时 entrypoint 从本行推导渲染 outgoing.proxies（同 2 的规则）。
# 加/换 proxy-hub 机器只改本行，searxng 下次重建自动生效。留空 = 整条 proxy-hub 链路
# 停用（上报/唤热/强制刷新静默跳过 + 无隧道直连出网）。供应商/分档/巡检配置见 proxy-hub 仓库。
PROXY_SERVICE_URL=
# ⚠️ 项目 token 唯一事实源：本行。控制面 Bearer 鉴权与隧道账密（prism:<token>@host:8101）
# 都从本行取，任何配置/模板不再内嵌 token。轮换 token：proxy-hub 重注册 + 只改本行，
# searxng 下次重建自动生效。（proxy-hub 侧 POST /admin/projects 注册 "prism" 项目获得；
# 空 = 控制面调用被 403、隧道认证失败）
PROXY_PROJECT_TOKEN=

# --- 引擎熔断 ---
# 单引擎 CIRCUIT_TTL_S 秒内失败 ≥3 次 → 后续请求跳过该引擎。默认 9s；
# 走代理的引擎（searxng/chinaso）跨阈值会异步请 proxy-hub 立即抽新 IP，故无需设大。
# 设太小→刚熔断就被试探放行又超时；设太大→IP 已恢复仍干等
CIRCUIT_TTL_S=9
ENGINE_TIMEOUT_S=5.0
RESPONSE_TIME_BUDGET_S=10.0
# 代理质量失败（验证码/IP 被风控导致 0 结果）时的额外重试预算：
# 总耗时可到 RESPONSE_TIME_BUDGET_S + 本值。等 proxy-hub 补新 IP + 换 IP 重试都从这里出
PROXY_RETRY_EXTRA_BUDGET_S=5.0
# RECALL_MONOPOLY_RETRY/SHARE: raw>0 但被单一低信任（非 T1/T2）域名垄断 ≥share 时，
# 视为分片大面积被风控只剩独苗源（如 10/10 全是 weixin.sogou.com 陈货），
# 按代理质量问题刷新 IP + 延长预算重试一轮，已有结果保留并入
RECALL_MONOPOLY_RETRY=true
RECALL_MONOPOLY_SHARE=0.7
# RECALL_STALE_MAX_AGE_DAYS: 未显式传 TimeRange 时，发布时间早于此天数的非 T1/T2
# 结果直接丢弃（推荐/对比类查询被多年前陈货霸榜的治理）；滤空则 fail-open 放过
RECALL_STALE_MAX_AGE_DAYS=730
# RANKING_BUDGET_S: semantic rank max wait before cheap fallback.
RANKING_BUDGET_S=2.5
# --- Tier 开关 ---
TIER2_DEFAULT=none                 # none | dataforseo | serper | brave | volcengine
TIER3_PLAYWRIGHT_ENABLED=false
TIER3_PROXY_POOL=selfhosted        # selfhosted | residential | datacenter

# --- 代理预算 ---
PROXY_DAILY_BUDGET_USD=10.0

# --- 性能预算（秒）---
# SEARCH_TOTAL_BUDGET_S：fast-path（不抓正文/不摘要）总耗时目标
SEARCH_TOTAL_BUDGET_S=3.0
# CONTENT_FETCH_BUDGET_S：NeedContent=true 时抓取所有页面的墙钟上限。
# 出网慢的机房单页 TLS 握手就要 2-3s，10 个并发需要更大预算，否则抓取赶不上闸被掐。
CONTENT_FETCH_BUDGET_S=4.0
# CONTENT_FETCH_MIN_BUDGET_S：正文抓取的预算下限。引擎/rank 把 RESPONSE_TIME_BUDGET_S
# 挤到只剩零点几秒时正文必空（无正文对 deep research 类调用方等于不可用）；
# 代价是极端情况总响应最多超出 RESPONSE_TIME_BUDGET_S 约此值。
CONTENT_FETCH_MIN_BUDGET_S=1.5
# CONTENT_FETCH_CONCURRENCY: URL fetch concurrency for NeedContent=true; 0=one task per result, >0=cap.
CONTENT_FETCH_CONCURRENCY=0
# CONTENT_FETCH_EGRESS: 正文抓取出网顺序。proxy_first（默认）=代理隧道（运营商 IP 池）
# 优先、直连兜底——内容站风控对运营商 IP 比服务器机房 IP 友好；direct_first=直连优先、
# 隧道兜底（家庭宽带等本身即运营商出口的环境适用）。未配 PROXY_SERVICE_URL 时都退化为直连。
CONTENT_FETCH_EGRESS=proxy_first
# CONTENT_PARSE_CONCURRENCY: trafilatura/readability parse concurrency; 0=max(2, CPU core count).
CONTENT_PARSE_CONCURRENCY=0
# SUMMARY_BUDGET_S：NeedSummary=true 时等待摘要的上限（当前抽取式 <100ms，纯安全网）
SUMMARY_BUDGET_S=0.6

# --- Crawl4AI（JS 渲染页抓取）吞吐 ---
# 注意：抓取成功率主要受源站可抓性限制（大量聚合页反爬/登录墙），调大这俩不涨命中、
# 只增延迟，弱机器还会被多标签压垮。保持保守默认即可。
CRAWL4AI_TIMEOUT_S=2.5       # 单页渲染+抽取超时（秒）
CRAWL4AI_CONCURRENCY=0       # 0=auto cpu/2, at least 1; >0=browser tab cap

# --- 治理 ---
GOVERNANCE_DEFAULT_PATH=standard   # fast | standard | deep
GOVERNANCE_AIGC_MIN_MODEL=rules    # rules (S 档) | qwen2.5-0.5b-onnx (M/L 档)

# HuggingFace 镜像（国内必填，否则模型下载超时）
# 已在 docker-compose.yml gateway.environment 中设为 https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com

# 语义向量模型（bi-encoder）：空 = 禁用，回退到 6 因子排序
# CPU 推理耗时：~65-110ms/批（4核/2并发）；内存占用：~90MB
# 模型由 Dockerfile 烘焙到 HF cache，sentence_transformers 按名称自动加载
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_NUM_THREADS=2                    # PyTorch BLAS 内部线程/推理（建议 = 核数/并发数）
EMBED_MAX_CONCURRENT=2                 # 最大并发推理任务数（建议 = 核数/线程数）

# 语义重排模型（cross-encoder）：none = 禁用
# CPU 推理耗时：base ~0.5-1.5s / v2-m3 ~2-4s（top-20，4核）
# 内存占用：base ~1.1GB / v2-m3 ~2.3GB；4c8g 机器选 base
# 仅冷路（SearXNG 结果）执行，热路跳过
RERANKER_MODEL=BAAI/bge-reranker-base          # none | BAAI/bge-reranker-base | BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=10
# 精排绝对地板：sigmoid 低于此值的结果丢弃（假相关 SEO 页）；0 = 关闭。护栏不回填低于地板的条目
RERANKER_SCORE_FLOOR=0.25
# 相对断层闸门：丢掉比当批最高 sigmoid 低超过此值的结果（base 输出压缩在 ~0.5-0.73，固定
# 地板咬不住，按当批分布相对下切）；0 = 关闭。实际阈 = max(floor, top-margin)
RERANKER_SCORE_MARGIN=0.15
# 塌缩闸门：整批最高 sigmoid 都低于此值 = 召回失败/全跑题，只留 COLLAPSE_KEEP 条，不把一池
# 跑题页全交付（base 实测好结果头部 >0.7，全跑题塌在 ~0.5-0.61）；0 = 关闭。
# 注意：换 v2-m3 后 sigmoid 分布更开，必须重新标定此值
RERANKER_COLLAPSE_CEILING=0.65
RERANKER_COLLAPSE_KEEP=2

# --- 鉴权 / 配额 ---
# 首次启动时用于创建第一个 API key；填随机 64 位字符串
ADMIN_BOOTSTRAP_KEY=
DEFAULT_QUOTA_PER_DAY=1000
DEFAULT_RATE_LIMIT_QPS=5

# --- 安全 ---
# openssl rand -hex 32
HMAC_SALT=

# --- 合规 ---
PREFERENCE_RETENTION_DAYS=90
ENFORCE_DOMESTIC_QUERIES=false     # true = 敏感词强制只走国内引擎
